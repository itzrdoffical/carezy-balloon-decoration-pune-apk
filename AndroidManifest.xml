
name: Carezy Android APK Build

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Check Android Project
        run: |
          echo "Checking project..."
          ls -la

          if [ ! -d "android" ]; then
            echo "Android folder not found!"
            echo "APK cannot be built until Android project is added."
            exit 1
          fi

          if [ ! -f "android/gradlew" ]; then
            echo "Gradle wrapper missing!"
            exit 1
          fi

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Carezy-Balloon-Decoration-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
